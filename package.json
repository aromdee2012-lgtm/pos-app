{
  "name": "pos-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.pos.app",
    "productName": "TEXAS INTECH POS",
    "win": {
      "icon": "icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
